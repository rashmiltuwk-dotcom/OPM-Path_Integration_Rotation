%% Trigger OptiTrack with Matlab
% Connect to optitrack
addpath(genpath('C:\Users\omotion\Documents\NatNetSDK'));
natnetclient = natnet;
% natnetclient.HostIP = '127.0.0.1';
% natnetclient.ClientIP = '127.0.0.1';
natnetclient.HostIP = '128.40.164.130'; % use these ones if not using local host
natnetclient.ClientIP = '128.40.164.130';
natnetclient.ConnectionType = 'Multicast';
natnetclient.connect;
if ( natnetclient.IsConnected == 0 )
fprintf( 'Client failed to connect\n' )
fprintf( '\tMake sure the host is connected to the network\n' )
fprintf( '\tand that the host and client IP addresses are correct\n\n' )
return
end
% Connect to NI trigger box
s = daq.createSession('ni');
addDigitalChannel(s, 'Dev1', 'Port0/Line0', 'OutputOnly' );
%% User input
% Wait for button press
fprintf('Press any key to trigger optitrack\n');
pause;
% Start optitrack recording
natnetclient.startRecord();
% Send trigger to OPMs
outputSingleScan(s,1);
% IMMEDIATELY lock the timestamp in the bridge
OptiTrackBridge.MarkTimeZero();
% Wait for button press
fprintf('Press any key to stop optitrack recording\n');
pause;
% Stop optitrack recording
natnetclient.stopRecord();
% Stop trigger to OPMs
outputSingleScan(s,0)
