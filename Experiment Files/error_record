function FrameCallback(varargin)
    % Extract frame data from variable arguments
    if nargin < 2
        error('FrameCallback: Expected at least 2 input arguments');
    end
    data = varargin{2};  % Second argument is the frame data
    
    % Rest of your callback code here (unchanged)
    global OP_BRIDGE_STATE;
    
    if OP_BRIDGE_STATE.MotiveT0 == 0
        OP_BRIDGE_STATE.MotiveT0 = double(data.fTimestamp);
        if data.bRecording
            fprintf('>>> Motive Recording started. T=0 anchored.\n');
        else
            fprintf('>>> Script started (Motive not recording). T=0 anchored.\n');
        end
    end
    
    % ... rest of callback
end
