function FrameCallback(source, eventData)
    data = eventData.data;
    
    if isempty(data) || data.nRigidBodies == 0
        fprintf('.');
        return;
    end
    
    for i = 1:data.nRigidBodies
        rb = data.RigidBodies(i);
        fprintf('[ID=%d Err=%.6f] ', rb.ID, rb.MeanError);
    end
    fprintf('\n');
    
end
