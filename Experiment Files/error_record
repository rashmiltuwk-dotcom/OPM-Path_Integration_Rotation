function FrameCallback(varargin)
    % DIAGNOSTIC: Log every callback to understand natnet signature
    persistent call_count;
    if isempty(call_count)
        call_count = 0;
    end
    call_count = call_count + 1;
    
    fprintf('\n=== FrameCallback call #%d ===\n', call_count);
    fprintf('nargin = %d\n', nargin);
    
    for i = 1:nargin
        arg = varargin{i};
        fprintf('  Arg %d: class=%s, size=', i, class(arg));
        if isstruct(arg)
            fprintf('[struct with fields: %s]\n', strjoin(fieldnames(arg), ', '));
        elseif isobject(arg)
            fprintf('[object]\n');
        else
            try
                sz = size(arg);
                fprintf('%s\n', mat2str(sz));
            catch
                fprintf('[unknown]\n');
            end
        end
    end
    
    if call_count <= 3
        fprintf('(showing first 3 calls only)\n');
    elseif call_count == 4
        fprintf('(suppressing further output)\n');
    end
    
    if call_count > 3
        return;  % Stop processing after diagnostic calls
    end
end
