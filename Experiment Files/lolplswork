classdef OptiTrackBridge
    % OPTITRACKBRIDGE
    % Handles connection to OptiTrack Motive using the natnet class.
    % DUMMY MODE UPDATE: Press 'x' to bypass all tracking phases.
    
    properties (Constant)
        FORCE_DUMMY_MODE = false; 

        % --- NETWORKING SETUP ---
        HOST_IP = '128.40.164.130';     % The IP address of the computer running Motive
        CLIENT_IP = '128.40.164.174';   % The IP address of THIS computer (running MATLAB)

        % ID CONSTANTS (Match these to Motive)
        HEAD_ID = 1;     
        TORSO_ID = 2;    
    end
    
    properties (GetAccess = private, SetAccess = private)
        NatNetClient;
        IsConnected = false;
        IsDummy = false;
    end
    
    methods (Static)
        
        function success = Connect()
            global OP_BRIDGE_STATE
            clear global OP_BRIDGE_STATE; 
            global OP_BRIDGE_STATE
            OP_BRIDGE_STATE = OptiTrackBridge;
            
            if OptiTrackBridge.FORCE_DUMMY_MODE
                OP_BRIDGE_STATE.IsDummy = true;
                success = true;
                return;
            end
            
            try
                fprintf('Creating natnet class object...\n');
                OP_BRIDGE_STATE.NatNetClient = natnet;

                fprintf('Connecting to the server at %s...\n', OptiTrackBridge.HOST_IP);
                OP_BRIDGE_STATE.NatNetClient.HostIP = OptiTrackBridge.HOST_IP;
                OP_BRIDGE_STATE.NatNetClient.ClientIP = OptiTrackBridge.CLIENT_IP;
                OP_BRIDGE_STATE.NatNetClient.ConnectionType = 'Multicast';

                OP_BRIDGE_STATE.NatNetClient.connect;

                if (OP_BRIDGE_STATE.NatNetClient.IsConnected == 0)
                    warning('Client failed to connect. Check IPs and Motive streaming settings.');
                    OP_BRIDGE_STATE.IsDummy = true;
                    success = false;
                else
                    OP_BRIDGE_STATE.IsConnected = true;
                    success = true;
                    fprintf('Connected to Motive successfully.\n');
                end
                
            catch ME
                warning('Connection Failed: %s', ME.message);
                warning('OptiTrack error. Using DUMMY MODE.');
                OP_BRIDGE_STATE.IsDummy = true;
                success = false;
            end
        end
        
        function Disconnect()
            global OP_BRIDGE_STATE
            if ~isempty(OP_BRIDGE_STATE) && ~OP_BRIDGE_STATE.IsDummy
                try 
                    OP_BRIDGE_STATE.NatNetClient.disable(0);
                    OP_BRIDGE_STATE.NatNetClient.disconnect;
                catch
                end
            end
            clear global OP_BRIDGE_STATE;
        end

        % ---------------------------------------------------------
        % WAIT FOR ORIGIN (WALKING) - SEMI-CIRCLE UPDATE
        % ---------------------------------------------------------
        function [distWalked, headTraces, torsoTraces] = WaitForOrigin(headID, torsoID, win, tolerance)
            global OP_BRIDGE_STATE
            if nargin < 4, tolerance = 0.10; end 
            
            % --- DUMMY MODE BYPASS ---
            if OP_BRIDGE_STATE.IsDummy
                DrawFormattedText(win, 'DUMMY MODE: Press "x" to simulate walking to center.', 'center', 'center', [255 255 0]);
                Screen('Flip', win);
                while true
                    [kd, ~, kc] = KbCheck;
                    if kd && kc(KbName('ESCAPE')), error('User Quit'); end
                    if kd && kc(KbName('r')), error('Redo_Trial'); end                        
                    if kd && kc(KbName('x'))
                        WaitSecs(0.3); % Debounce to prevent double-skipping
                        break;
                    end
                end
                distWalked = 2.0; % Fake distance
                headTraces.time = [0]; headTraces.x = [0]; headTraces.z = [0];
                torsoTraces.time = [0]; torsoTraces.x = [0]; torsoTraces.z = [0];
                return;
            end
            % -------------------------

            % --- 1. INITIALIZATION & SETUP ---
            startTime = GetSecs();
            % Track start distance based on the Torso
            startTorsoPos = OptiTrackBridge.GetPosition(torsoID); 
            
            white = WhiteIndex(win);
            Screen('TextSize', win, 40);

            % --- 2. MEMORY PRE-ALLOCATION ---
            maxSamples = 10000; 
            tData = nan(maxSamples, 1); 
            hxData = nan(maxSamples, 1); % Head X
            hzData = nan(maxSamples, 1); % Head Z
            txData = nan(maxSamples, 1); % Torso X
            tzData = nan(maxSamples, 1); % Torso Z
            idx = 1;

            % --- 3. THE ACTIVE TRACKING LOOP ---
            while true
                [kd, ~, kc] = KbCheck;
                if kd && kc(KbName('ESCAPE')), error('User Quit'); end
                if kd && kc(KbName('r')), error('Redo_Trial'); end 

                % Grab both positions
                currHeadPos = OptiTrackBridge.GetPosition(headID);
                currTorsoPos = OptiTrackBridge.GetPosition(torsoID);

                % --- NEW SAFETY CHECK ---
                if any(isnan(currHeadPos)) || any(isnan(currTorsoPos))
                    DrawFormattedText(win, '!!! TRACKING LOST !!!\nAdjust markers or move to visible area', 'center', 'center', [255 0 0]);
                    Screen('Flip', win);
                    continue; 
                end
                
                
                zTarget = -0.25;
                
                % Calculate how far they are from the center based on the Torso
                distToCenter = sqrt(currTorsoPos(1)^2 + (currTorsoPos(3) - zTarget)^2);
                
                % --- NEW SEMI-CIRCLE LOGIC ---
                inSemiCircle = (distToCenter < tolerance) && (currTorsoPos(3) >= zTarget);
                
                % --- 4. RECORDING THE DATA ---
                if idx <= maxSamples
                    tData(idx) = GetSecs() - startTime; 
                    hxData(idx) = currHeadPos(1);            
                    hzData(idx) = currHeadPos(3); 
                    txData(idx) = currTorsoPos(1);            
                    tzData(idx) = currTorsoPos(3);            
                    idx = idx + 1;                      
                end
                
                % --- 5. VISUAL FEEDBACK (ON-SCREEN) ---
                msg = sprintf('Walk to Start\nDistance: %.2fm', distToCenter);
                DrawFormattedText(win, msg, 'center', 'center', white);
                
                if inSemiCircle
                    color = [0 255 0]; % Green if inside the valid semi-circle
                else
                    color = [255 0 0]; % Red if outside (or in the wrong half)
                end
                
                centeredRect = CenterRectOnPointd([0 0 50 50], 960, 600);
                Screen('FillArc', win, color, centeredRect + [0 100 0 100], 270, 180);
                Screen('Flip', win); 

                % --- 6. THE SUCCESS CHECK ---
                if inSemiCircle
                    DrawFormattedText(win, 'Hold Position...', 'center', 'center', [0 255 0]);
                    Screen('FillArc', win, [0 255 0], centeredRect + [0 100 0 100], 270, 180);
                    Screen('Flip', win);
                    break;
                end
            end
            
            % --- 7. FINAL CALCULATIONS & DATA PACKAGING ---
            distWalked = sqrt((currTorsoPos(1) - startTorsoPos(1))^2 + (currTorsoPos(3) - startTorsoPos(3))^2);
            
            % Package Head Traces
            headTraces.time = tData(1:idx-1);
            headTraces.x = hxData(1:idx-1);
            headTraces.z = hzData(1:idx-1);

            % Package Torso Traces
            torsoTraces.time = tData(1:idx-1);
            torsoTraces.x = txData(1:idx-1);
            torsoTraces.z = tzData(1:idx-1);
        end

        % ---------------------------------------------------------
        % WAIT FOR ROTATION DUAL (TURNING)
        % ---------------------------------------------------------
        function [startHead, startTorso, finalHead, finalTorso, headTrace, torsoTrace] = WaitForRotationDual(headID, torsoID, targetDeg, win, dirCode)
            global OP_BRIDGE_STATE
            
            [startHead, startTorso] = OptiTrackBridge.GetDualYaw();
            prevTorsoYaw = startTorso; 
            accumulatedTurn = 0;       
            startTime = GetSecs();     
            white = WhiteIndex(win);
            
            maxSamples = 20000;
            tData = nan(maxSamples, 1);   
            hData = nan(maxSamples, 1);   
            tsoData = nan(maxSamples, 1); 
            idx = 1;      
            
            KbReleaseWait;
            
            while true
                [kd, ~, kc] = KbCheck;
                if kd && kc(KbName('ESCAPE')), error('User Quit'); end
                if kd && kc(KbName('r')), error('Redo_Trial'); end 
                
                [currHead, currTorso] = OptiTrackBridge.GetDualYaw();
                
                if any(isnan([currHead, currTorso]))
                   WaitSecs(0.01);
                   continue;
                end

                if idx <= maxSamples
                    tData(idx) = GetSecs() - startTime; 
                    hData(idx) = currHead;              
                    tsoData(idx) = currTorso;           
                    idx = idx + 1;                      
                end
                
                delta = currTorso - prevTorsoYaw;
                if delta > 180,  delta = delta - 360; end
                if delta < -180, delta = delta + 360; end
                accumulatedTurn = accumulatedTurn + delta; 
                prevTorsoYaw = currTorso;

                remaining = targetDeg - abs(accumulatedTurn);
                msg = sprintf('Turn Body: %.1f / %.1f\nRemaining: %.1f', abs(accumulatedTurn), targetDeg, max(0, remaining));
                DrawFormattedText(win, msg, 'center', 'center', white);
                Screen('Flip', win);

                if abs(accumulatedTurn) >= targetDeg
                    turnedLeftCorrectly  = strcmpi(dirCode, 'L') && (accumulatedTurn >= targetDeg);
                    turnedRightCorrectly = strcmpi(dirCode, 'R') && (accumulatedTurn <= -targetDeg);
                    
                    if turnedLeftCorrectly || turnedRightCorrectly
                        DrawFormattedText(win, 'DONE! STOP.', 'center', 'center', [0 255 0]);
                        Screen('Flip', win); 
                        break;
                    else
                        DrawFormattedText(win, 'INCORRECT DIRECTION\nRestarting Trial...', 'center', 'center', [255 0 0]);
                        Screen('Flip', win);
                        WaitSecs(3.0);
                        error('Redo_Trial'); 
                    end
                end
            end
            
            finalHead = currHead; 
            finalTorso = currTorso;
            headTrace.time = tData(1:idx-1); 
            headTrace.yaw = hData(1:idx-1);
            torsoTrace.time = tData(1:idx-1); 
            torsoTrace.yaw = tsoData(1:idx-1);
        end

        % ---------------------------------------------------------
        % RECORD UNTIL KEY (PRODUCTION / IMAGINE)
        % ---------------------------------------------------------

        function [finalHead, finalTorso, headTrace, torsoTrace] = RecordUntilKey(headID, torsoID, keyName, win)
            global OP_BRIDGE_STATE
            
            targetKey = KbName(keyName);
            escKey = KbName('ESCAPE');
            xKey = KbName('x'); 
            rKey = KbName('r');

            if OP_BRIDGE_STATE.IsDummy
                DrawFormattedText(win, sprintf('DUMMY MODE: Press "x" (or %s) to finish task.', keyName), 'center', 'center', [255 255 0]);
                Screen('Flip', win);
                while true
                    [kd, ~, kc] = KbCheck;
                    if kd && any(kc(escKey)), error('User Quit'); end
                    if kd && any(kc(rKey)), error('Redo_Trial'); end
                    
                    if kd && (any(kc(targetKey)) || any(kc(xKey)))
                        WaitSecs(0.3); 
                        break;
                    end
                end
                
                finalHead = 0; finalTorso = 0;
                headTrace.time = [0]; headTrace.yaw = [0];
                torsoTrace.time = [0]; torsoTrace.yaw = [0];
                return; 
            end

            startTime = GetSecs();
            white = WhiteIndex(win);
            
            maxSamples = 10000; 
            tData = nan(maxSamples, 1);   
            hData = nan(maxSamples, 1);   
            tsoData = nan(maxSamples, 1); 
            idx = 1;

            currHead = NaN; 
            currTorso = NaN;

            DrawFormattedText(win, sprintf('Perform task...\nPress %s when finished.', keyName), 'center', 'center', white);
            Screen('Flip', win);

            KbReleaseWait;

            while true
                [kd, ~, kc] = KbCheck;
                
                if kd && any(kc(escKey)), error('User Quit'); end
                if kd && any(kc(rKey)), error('Redo_Trial'); end 
                
                if kd && any(kc(targetKey)), break; end
                
                [currHead, currTorso] = OptiTrackBridge.GetDualYaw();
                
                if any(isnan([currHead, currTorso]))
                    WaitSecs(0.01);
                    continue;
                end
                
                if idx <= maxSamples
                    tData(idx) = GetSecs() - startTime; 
                    hData(idx) = currHead;              
                    tsoData(idx) = currTorso;           
                    idx = idx + 1;                      
                end
                
                WaitSecs(0.01); 
            end
            
            finalHead = currHead; 
            finalTorso = currTorso;
            
            headTrace.time = tData(1:idx-1); 
            headTrace.yaw = hData(1:idx-1);
            
            torsoTrace.time = tData(1:idx-1); 
            torsoTrace.yaw = tsoData(1:idx-1);
        end

        % ---------------------------------------------------------
        % SAFE DATA EXTRACTION HELPERS
        % ---------------------------------------------------------
        function [headYaw, torsoYaw] = GetDualYaw()
            global OP_BRIDGE_STATE
            if OP_BRIDGE_STATE.IsDummy
                headYaw = 0; torsoYaw = 0; return; 
            end
            headYaw = NaN; torsoYaw = NaN;
            
            try
                data = OP_BRIDGE_STATE.NatNetClient.getFrame();
                if isempty(data), data = OP_BRIDGE_STATE.NatNetClient.GetLastFrameOfData(); end
                if isempty(data) || isempty(data.RigidBody), return; end
                
                for i = 1:data.RigidBody.Length
                    rb = data.RigidBody(i);
                    if rb.ID == OptiTrackBridge.HEAD_ID
                        headYaw = OptiTrackBridge.QuatToYaw(rb.qw, rb.qx, rb.qy, rb.qz);
                    elseif rb.ID == OptiTrackBridge.TORSO_ID
                        torsoYaw = OptiTrackBridge.QuatToYaw(rb.qw, rb.qx, rb.qy, rb.qz);
                    end
                end
            catch
            end
        end

        function pos = GetPosition(rbID)
            global OP_BRIDGE_STATE
            if OP_BRIDGE_STATE.IsDummy
                pos = [0 0 0]; return; 
            end
            pos = [NaN, NaN, NaN]; 
            
            try
                data = OP_BRIDGE_STATE.NatNetClient.getFrame();
                if isempty(data), data = OP_BRIDGE_STATE.NatNetClient.GetLastFrameOfData(); end
                if isempty(data) || isempty(data.RigidBody), return; end
                
                for i = 1:data.RigidBody.Length
                    rb = data.RigidBody(i);
                    if rb.ID == rbID
                        pos = [double(rb.x), double(rb.y), double(rb.z)];
                        return;
                    end
                end
            catch
            end
        end
        
        function yaw = QuatToYaw(qw, qx, qy, qz)
            t3 = 2.0 * (qw*qy - qz*qx);
            t4 = 1.0 - 2.0 * (qy*qy + qz*qz);
            yaw = mod(rad2deg(atan2(t3, t4)), 360);
        end
        
    end
end
