function test_experiment_minimal
% Minimal test: just the OptiTrack parts, no Screen or Audio

clear all; close all;

fprintf('TEST: Initializing OptiTrack...\n');
OptiTrackBridge.Connect('001');
fprintf('TEST: Connected\n');

headID = 1;
torsoID = 2;

% Test each function in isolation
fprintf('\n=== TEST 1: PassiveTrack (1 sec) ===\n');
try
    [h1, t1] = OptiTrackBridge.PassiveTrack(headID, torsoID, 1.0);
    fprintf('SUCCESS: PassiveTrack completed\n');
    fprintf('  HeadTrace size: %d rows\n', length(h1.time));
    fprintf('  TorsoTrace size: %d rows\n', length(t1.time));
catch ME
    fprintf('ERROR in PassiveTrack:\n');
    fprintf('  %s\n', ME.message);
    return;
end

fprintf('\n=== TEST 2: GetOpti (10 frames) ===\n');
try
    for i = 1:10
        [headPos, torsoPos, headEuler, torsoEuler] = OptiTrackBridge.GetOpti();
        fprintf('  Frame %d: Head=%.2f,%.2f,%.2f\n', i, headPos(1), headPos(2), headPos(3));
    end
    fprintf('SUCCESS: GetOpti completed\n');
catch ME
    fprintf('ERROR in GetOpti:\n');
    fprintf('  %s\n', ME.message);
    return;
end

fprintf('\n=== TEST 3: GetPositionAndEuler (10 frames) ===\n');
try
    for i = 1:10
        [pos, euler] = OptiTrackBridge.GetPositionAndEuler(headID);
        fprintf('  Frame %d: Pos=%.2f,%.2f,%.2f Yaw=%.1f\n', i, pos(1), pos(2), pos(3), euler(3));
    end
    fprintf('SUCCESS: GetPositionAndEuler completed\n');
catch ME
    fprintf('ERROR in GetPositionAndEuler:\n');
    fprintf('  %s\n', ME.message);
    return;
end

fprintf('\n=== TEST 4: GetDualYaw (10 frames) ===\n');
try
    for i = 1:10
        [headYaw, torsoYaw] = OptiTrackBridge.GetDualYaw();
        fprintf('  Frame %d: HeadYaw=%.1f TorsoYaw=%.1f\n', i, headYaw, torsoYaw);
    end
    fprintf('SUCCESS: GetDualYaw completed\n');
catch ME
    fprintf('ERROR in GetDualYaw:\n');
    fprintf('  %s\n', ME.message);
    return;
end

fprintf('\n=== TEST 5: Disconnect ===\n');
try
    OptiTrackBridge.Disconnect();
    fprintf('SUCCESS: Disconnected\n');
catch ME
    fprintf('ERROR in Disconnect:\n');
    fprintf('  %s\n', ME.message);
    return;
end

fprintf('\n*** ALL TESTS PASSED ***\n');

end
