%% PATH VISUALIZER
timeStart = 0;
timeEnd   = 600; % seconds

figure(1); clf; hold on;
set(gcf, 'Position', [100, 100, 900, 800], 'Color', 'w');

mask = headTrace.time >= timeStart & headTrace.time <= timeEnd;
plot(headTrace.x(mask),  headTrace.z(mask),  'Color', [1.00 0.40 0.00 1.00], 'LineWidth', 2.5);

mask = torsoTrace.time >= timeStart & torsoTrace.time <= timeEnd;
plot(torsoTrace.x(mask), torsoTrace.z(mask), 'Color', [0.00 0.50 1.00 0.60], 'LineWidth', 2);

plot(0, 0, 'k*', 'MarkerSize', 15, 'LineWidth', 2);

title(sprintf('Paths: XZ Coordinates (t = %.1f – %.1f s)', timeStart, timeEnd), 'FontSize', 16);
xlabel('Room X Position (Meters)', 'FontSize', 14);
ylabel('Room Z Position (Meters)', 'FontSize', 14);
legend({'Head Path', 'Torso Path', 'Target Center'}, 'Location', 'bestoutside');
axis equal; grid on; hold off;
